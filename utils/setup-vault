#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["nbtlib"]
# ///

import sys
import nbtlib

if len(sys.argv) != 2:
    print("Usage: setup-vault <structure.nbt>")
    sys.exit(1)

path = sys.argv[1]

STANDARD_LOOT_TABLE = "sargasso:escher/normal"
OMINOUS_LOOT_TABLE = "sargasso:escher/ominous"

STANDARD_KEY = "sargasso:key"
OMINOUS_KEY = "sargasso:key_ominous"

nbt = nbtlib.load(path)

count = 0

for block in nbt["blocks"]:
    be = block.get("nbt")

    if not be or be.get("id") != "minecraft:vault":
        continue

    config = be.setdefault("config", nbtlib.Compound())

    state = block.get("state")

    if state:
        pass

    palette = nbt["palette"]
    state_data = palette[state]

    ominous = state_data.get("Properties", {}).get("ominous") == "true"

    if ominous:
        config["loot_table"] = nbtlib.String(OMINOUS_LOOT_TABLE)
        config["key_item"] = nbtlib.Compound({
            "id": nbtlib.String(OMINOUS_KEY)
        })
    else:
        config["loot_table"] = nbtlib.String(STANDARD_LOOT_TABLE)
        config["key_item"] = nbtlib.Compound({
            "id": nbtlib.String(STANDARD_KEY)
        })
    
    be.pop("server_data", None)

    count += 1

nbt.save()

print(f"Updated {count} vault(s) in {path}")